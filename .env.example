# Cloudflare R2 — Private S3 API configuration
# Cloudflare Account ID (found in Cloudflare dashboard URL or R2 overview)
R2_ACCOUNT_ID=

# R2 API Token: Access Key ID (scoped to shan-media bucket)
R2_ACCESS_KEY_ID=

# R2 API Token: Secret Access Key
R2_SECRET_ACCESS_KEY=

# R2 Bucket Name
R2_BUCKET=shan-media

# Optional R2 Jurisdiction (e.g. eu, or leave empty for default/global)
R2_JURISDICTION=eu

# Public website media delivery URL (Cloudflare custom domain or worker)
PUBLIC_MEDIA_BASE_URL=https://media.shan.page
