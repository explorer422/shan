---
import type { CollectionEntry } from 'astro:content';
import { resolveMedia } from '../lib/media';
import { formatDate } from '../lib/date';

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const {
  title,
  excerpt,
  date,
  readingTime,
  tags,
  lang,
  coverMedia,
} = story.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const storyUrl = `${base}/stories/${story.id}/`;
const media = resolveMedia(coverMedia.id);
const dateStr = formatDate(date);
---

<a href={storyUrl} class="featured" data-tags={tags.join(',')}>
  <div class="image-wrap">
    <img
      class="featured-img"
      src={media.src}
      srcset={media.srcSet}
      alt={coverMedia.alt || title}
    />
  </div>
  <div class="featured-copy">
    <div class="eyebrow">
      Featured story <span style="margin:0 8px">/</span> {tags[0]}
    </div>
    <h2 lang={lang}>{title}</h2>
    <p class="excerpt">{excerpt}</p>
    <div class="meta">
      <time datetime={date.toISOString()}>{dateStr}</time>
      <span>·</span>
      <span>{readingTime || '7 min read'}</span>
    </div>
    <div class="read-link">
      Read the story <span>↗</span>
    </div>
  </div>
</a>
