---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import LightboxViewer from '../components/LightboxViewer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogType?: string;
  image?: string;
  article?: boolean;
  is404?: boolean;
}

const {
  title = '山 / SHAN — Notes along the way',
  description = 'A personal journal of forests, places, and small discoveries.',
  lang = 'en',
  ogType: initialOgType,
  image,
  article = false,
  is404: propIs404,
} = Astro.props;

const ogType = initialOgType || (article ? 'article' : 'website');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconSvgUrl = `${base}/favicon.svg`;
const faviconIcoUrl = `${base}/favicon.ico`;
const favicon32Url = `${base}/favicon-32x32.png`;
const appleTouchIconUrl = `${base}/apple-touch-icon.png`;

const is404 =
  propIs404 ??
  (Astro.url.pathname === '/404' ||
    Astro.url.pathname === '/404/' ||
    Astro.url.pathname.endsWith('/404.html'));

const siteUrl = Astro.site ?? new URL('https://shan.page');
// ponytail: Ensure trailing slash consistency on canonical path
let canonicalPath = Astro.url.pathname;
if (!is404 && !canonicalPath.endsWith('/')) {
  canonicalPath += '/';
}
const canonicalURL = new URL(canonicalPath, siteUrl);
const rssUrl = new URL(`${base}/rss.xml`, siteUrl).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      is404 ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalURL.href} />
          <meta property="og:url" content={canonicalURL.href} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:image" content={image} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="SHAN — Stories & Moments"
      href={rssUrl}
    />
    <link rel="icon" href={faviconIcoUrl} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link
      rel="icon"
      type="image/png"
      href={favicon32Url}
      sizes="32x32"
    />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} sizes="180x180" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('shan-theme');
        var prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <MobileDrawer />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <LightboxViewer />

    <script is:inline>
      (function () {
        var themeBtn = document.getElementById('theme');
        var menuBtn = document.getElementById('menu');
        var mobileMenu = document.getElementById('mobile-menu');

        var initial =
          localStorage.getItem('shan-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');

        if (initial === 'dark') {
          document.body.classList.add('dark');
        }

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var isDark = document.body.classList.toggle('dark');
            var next = isDark ? 'dark' : 'light';
            document.documentElement.classList.toggle('dark', isDark);
            localStorage.setItem('shan-theme', next);
            themeBtn.setAttribute(
              'aria-label',
              'Switch to ' + (isDark ? 'light' : 'dark') + ' theme'
            );
          });
        }

        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', function () {
            var hidden = !mobileMenu.hidden;
            mobileMenu.hidden = hidden;
            menuBtn.setAttribute('aria-expanded', String(!hidden));
          });
        }
      })();
    </script>
  </body>
</html>
