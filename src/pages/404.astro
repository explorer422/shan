---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = `${base}/`;
---

<BaseLayout title="Page Not Found — 山 / SHAN" is404={true}>
  <section class="about">
    <div class="eyebrow">404</div>
    <h1>Page not found.</h1>
    <p>
      The path you took seems to have wandered off into the woods.
    </p>
    <a class="back" href={homeUrl}>Return to home →</a>
  </section>
</BaseLayout>
