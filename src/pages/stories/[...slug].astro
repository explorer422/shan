---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveMedia } from '../../lib/media';
import { formatDate } from '../../lib/date';
import { tagToSlug } from '../../lib/tag';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story, allStories: stories },
  }));
}

const { story, allStories } = Astro.props;
const { Content } = await render(story);

const {
  title,
  excerpt,
  date,
  readingTime,
  tags,
  lang,
  coverMedia,
} = story.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const storiesUrl = `${base}/stories/`;
const media = resolveMedia(coverMedia.id);
const dateStr = formatDate(date);

const related = allStories
  .filter((s) => s.id !== story.id)
  .slice(0, 2);
---

<BaseLayout
  title={`${title} — 山 / SHAN`}
  description={excerpt}
  image={media.src}
  article={true}
>
  <article class="article" lang={lang}>
    <a class="back" href={storiesUrl}>← All stories</a>
    <div class="eyebrow">{tags.join(' / ')}</div>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>{dateStr}</time>
      <span>·</span>
      <span>{readingTime || '5 min read'}</span>
    </div>
    <p class="lead">{excerpt}</p>
    <img
      class="article-cover"
      src={media.src}
      srcset={media.srcSet}
      alt={coverMedia.alt || title}
    />
    <div class="prose">
      <Content />
    </div>
    <div class="filters" style="margin-top:35px">
      {
        tags.map((t) => (
          <a class="chip" href={`${base}/tags/${tagToSlug(t)}/`}>
            # {t}
          </a>
        ))
      }
    </div>
    {
      related.length > 0 && (
        <div class="related">
          <div class="eyebrow">Continue reading</div>
          {
            related.map((s) => (
              <a href={`${base}/stories/${s.id}/`}>
                {s.data.title} ↗
              </a>
            ))
          }
        </div>
      )
    }
  </article>
</BaseLayout>
